# TESAIoT Community Edition — MQTT telemetry simulator
DEVICE_ID=your-device-id

# CE EMQX serverTLS listener
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8884
MQTT_USE_TLS=true
MQTT_CA_CERT=../../../config/tls/ca-bundle.pem

# Auth: username = device_id, password from reset-mqtt-password
MQTT_USERNAME=your-device-id
MQTT_PASSWORD=your-mqtt-password

# CE ACL requires the MQTT client id to equal the device id
MQTT_CLIENT_ID=your-device-id

PUBLISH_INTERVAL=1.0
