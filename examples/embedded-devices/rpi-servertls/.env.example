# TESAIoT Community Edition — serverTLS device client
# Copy to .env and fill in the credentials issued by your CE install.

# Device identity (must match a device registered in the CE Admin UI)
DEVICE_ID=your-device-id

# --- MQTT (serverTLS, port 8884) ---
# CE exposes the serverTLS MQTT listener on the Docker host at localhost:8884.
MQTT_HOST=localhost
MQTT_PORT=8884
# Username is the device_id; password comes from the CE API:
#   POST /api/v1/devices/{DEVICE_ID}/reset-mqtt-password  (shown once)
MQTT_USERNAME=your-device-id
MQTT_PASSWORD=your-mqtt-password

# --- HTTPS / REST (port 443 via nginx/APISIX) ---
# CE REST ingest endpoint is POST {API_BASE_URL}/api/v1/telemetry
API_BASE_URL=https://localhost
# Device API key from:
#   POST /api/v1/devices/{DEVICE_ID}/regenerate-api-key   (shown once, prefix tesa_dak_)
API_KEY=your-device-api-key

# --- TLS trust ---
# CE private-PKI CA bundle. Copy it from the platform:
#   cp <ce-repo>/config/tls/ca-bundle.pem ./certs/ca.pem
CA_CERT_PATH=./certs/ca.pem
