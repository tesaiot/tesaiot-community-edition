# TESAIoT Live Streaming Dashboard Configuration
# Copy this file to .env and fill in your values

# MQTT WebSocket Broker URL
# Community Edition serves MQTT-over-WebSocket on 8083. Port 8085/WSS is a
# cloud-only listener and does not exist here.
# Default: ws://localhost:8083/mqtt
VITE_MQTT_BROKER_URL=ws://localhost:8083/mqtt

# MQTT Topic Pattern for Telemetry
# + = single level wildcard
# # = multi-level wildcard
# Default: device/+/telemetry/#
VITE_MQTT_TOPIC=device/+/telemetry/#

# Optional: Pre-filled Token (for development only, NOT recommended for production)
# VITE_MQTT_TOKEN=tesa_mqtt_your-org_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
