# ==============================================================================
# TESAIoT Community Edition — React telemetry dashboard
# Copy to .env. NEVER commit real credentials.
# ==============================================================================

# CE edge (nginx/APISIX)
VITE_API_BASE_URL=https://localhost

# CE gates device/telemetry reads behind JWT — provide login credentials,
# OR supply a pre-obtained token via VITE_JWT instead.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-me
# VITE_JWT=
